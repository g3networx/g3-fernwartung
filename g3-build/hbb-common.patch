+pub fn opslinx_tls_host(host: &str) -> bool {
+    option_env!("OPSLINX_TLS_REGISTRATION") == Some("1")
+        && (matches!(host, "linx.g3nx.net" | "rust.g3nx.net" | "opslinx02.g3nx.net" | "opslinx03.g3nx.net")
+            || option_env!("OPSLINX_TLS_LAB_HOST") == Some(host))
+}
+
+pub fn opslinx_tls_unavailable(error: &anyhow::Error) -> bool {
+    fn unavailable(error: &io::Error) -> bool {
+        matches!(error.kind(), ErrorKind::ConnectionRefused | ErrorKind::ConnectionReset
+            | ErrorKind::ConnectionAborted | ErrorKind::NotConnected | ErrorKind::TimedOut
+            | ErrorKind::UnexpectedEof)
+            || (cfg!(windows) && matches!(error.raw_os_error(), Some(10013 | 10051 | 10065)))
+    }
+    error.chain().any(|cause| {
+        if let Some(ws) = cause.downcast_ref::<tungstenite::Error>() {
+            return match ws {
+                tungstenite::Error::Io(error) => unavailable(error),
+                tungstenite::Error::Http(response) => matches!(response.status().as_u16(), 404 | 502 | 503 | 504),
+                _ => false,
+            };
+        }
+        cause.is::<tokio::time::error::Elapsed>()
+            || cause.downcast_ref::<io::Error>().is_some_and(unavailable)
+    })
+}
