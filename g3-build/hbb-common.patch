+async fn connect_opslinx_dual_stack(addresses: &[SocketAddr]) -> io::Result<TcpStream> {
+    let (v6, v4): (Vec<_>, Vec<_>) = addresses.iter().copied().partition(SocketAddr::is_ipv6);
+    if v6.is_empty() || v4.is_empty() {
+        return TcpStream::connect(addresses).await;
+    }
+    let ipv6 = TcpStream::connect(v6.as_slice());
+    let ipv4 = async {
+        tokio::time::sleep(Duration::from_millis(250)).await;
+        TcpStream::connect(v4.as_slice()).await
+    };
+    tokio::pin!(ipv6, ipv4);
+    tokio::select! {
+        result = &mut ipv6 => match result {
+            Ok(socket) => Ok(socket),
+            Err(_) => ipv4.await,
+        },
+        result = &mut ipv4 => match result {
+            Ok(socket) => Ok(socket),
+            Err(_) => ipv6.await,
+        },
+    }
+}
