+pub fn opslinx_tls_host(host: &str) -> bool {
+    option_env!("OPSLINX_TLS_REGISTRATION") == Some("1")
+        && (matches!(host, "linx.g3nx.net" | "rust.g3nx.net" | "opslinx02.g3nx.net" | "opslinx03.g3nx.net")
+            || option_env!("OPSLINX_TLS_LAB_HOST") == Some(host))
+}
+
 pub fn check_ws(endpoint: &str) -> String {
+    if let Some((host, port)) = split_host_port(endpoint) {
+        if opslinx_tls_host(&host) {
+            if port == RENDEZVOUS_PORT || port == RENDEZVOUS_PORT - 1 {
+                return format!("wss://{host}/ws/id");
+            }
+            if port == RELAY_PORT || port == 443 {
+                return format!("wss://{host}/ws/relay");
+            }
+        }
+    }
     if !use_ws() {
         return endpoint.to_string();
     }
