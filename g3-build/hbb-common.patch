+// A separate namespace prevents portable support from reusing an installed client.
+pub fn is_g3_adhoc() -> bool {
+ std::env::var("RUSTDESK_APPNAME").unwrap_or_default().to_lowercase().starts_with("g3-soforthilfe-")
+}
+
+pub fn is_g3_host() -> bool {
+ std::env::var("RUSTDESK_APPNAME").unwrap_or_default().to_lowercase().starts_with("g3-host-") || std::env::current_exe().ok().and_then(|p|p.file_name().map(|n|n.to_string_lossy().to_lowercase())).map_or(false,|n|n=="g3host.exe"||n.starts_with("g3host-"))
+}
+
+#[cfg(windows)]
+pub fn g3_reset_key_pair_cache() {
+ *KEY_PAIR.lock().unwrap() = None;
+}
