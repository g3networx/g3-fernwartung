diff --git a/test-tls-registration.py b/test-tls-registration.py
new file mode 100644
index 0000000..16dcf68
--- /dev/null
+++ b/test-tls-registration.py
@@ -0,0 +1,252 @@
+"""Run the registration protocol against an isolated hbbs and a TLS proxy."""
+from contextlib import closing, ExitStack
+from pathlib import Path
+import os
+import re
+import select
+import socket
+import socketserver
+import sqlite3
+import ssl
+import subprocess
+import sys
+from tempfile import TemporaryDirectory
+from threading import Thread
+import time
+from uuid import uuid4
+
+import websocket
+
+
+PROOF_DOMAIN = b"opslinx-device-registration-v1\0"
+ID = b"1456789123"
+UUID = bytes(range(16))
+
+
+def varint(value):
+    result = bytearray()
+    while value > 127:
+        result.append((value & 127) | 128)
+        value >>= 7
+    result.append(value)
+    return bytes(result)
+
+
+def field(number, data):
+    return varint(number * 8 + 2) + varint(len(data)) + data
+
+
+def keypair(folder, name):
+    key = folder / (name + ".pem")
+    subprocess.run(["openssl", "genpkey", "-algorithm", "Ed25519", "-out", key], check=True)
+    der = subprocess.check_output(["openssl", "pkey", "-in", key, "-pubout", "-outform", "DER"])
+    return key, der[-32:]
+
+
+def signed_registration(folder, key, public, nonce):
+    message = field(15, field(1, ID) + field(2, UUID) + field(3, public))
+    challenge = folder / "challenge"
+    challenge.write_bytes(PROOF_DOMAIN + nonce + message)
+    signature = subprocess.check_output(
+        ["openssl", "pkeyutl", "-sign", "-rawin", "-inkey", key, "-in", challenge]
+    )
+    return signature + message
+
+
+class Proxy(socketserver.BaseRequestHandler):
+    def handle(self):
+        try:
+            with self.server.tls.wrap_socket(self.request, server_side=True) as client:
+                client.settimeout(5)
+                headers = b""
+                while b"\r\n\r\n" not in headers and len(headers) < 8192:
+                    chunk = client.recv(2048)
+                    if not chunk:
+                        return
+                    headers += chunk
+                head, separator, body = headers.partition(b"\r\n\r\n")
+                lines = head.split(b"\r\n")
+                location = lines[0].split()[1] if lines and len(lines[0].split()) >= 2 else None
+                if not separator or location not in (b"/ws/register", b"/ws/id", b"/ws/relay"):
+                    return
+                lines = [line for line in lines if not re.match(br"x-real-ip:", line, re.I)]
+                lines.append(b"X-Real-IP: 192.0.2.1")
+                backend_port = 23519 if location == b"/ws/relay" else 23518
+                with socket.create_connection(("127.0.0.1", backend_port), timeout=5) as backend:
+                    backend.sendall(b"\r\n".join(lines) + separator + body)
+                    while True:
+                        readable = [client] if client.pending() else select.select([client, backend], [], [], 10)[0]
+                        if not readable:
+                            return
+                        for source in readable:
+                            data = source.recv(16384)
+                            if not data:
+                                return
+                            target = backend if source is client else client
+                            target.sendall(data)
+        except OSError:
+            return
+
+
+def main():
+    hbbs = Path(sys.argv[1]).resolve()
+    port = int(sys.argv[2])
+    with TemporaryDirectory(prefix="opslinx-tls-lab-") as tmp:
+        folder = Path(tmp)
+        cert = folder / "server.crt"
+        cert_key = folder / "server.key"
+        subprocess.run(
+            ["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1",
+             "-nodes", "-subj", "/CN=localhost", "-addext", "subjectAltName=DNS:localhost",
+             "-out", cert, "-keyout", cert_key, "-days", "1"],
+            check=True, capture_output=True,
+        )
+        tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        tls.load_cert_chain(cert, cert_key)
+        with socketserver.ThreadingTCPServer(("127.0.0.1", port), Proxy) as proxy:
+            proxy.daemon_threads = True
+            proxy.tls = tls
+            Thread(target=proxy.serve_forever, daemon=True).start()
+            env = dict(os.environ, OPSLINX_TLS_REGISTRATION="1", TEST_HBBS="no")
+            with (folder / "hbbs.log").open("w+") as log:
+                with ExitStack() as stack:
+                    services = [
+                        stack.enter_context(subprocess.Popen(
+                            [program, "-p", str(listen_port)], env=env, cwd=folder, stdout=log, stderr=log
+                        ))
+                        for program, listen_port in ((hbbs, 23516), (hbbs.with_name("hbbr"), 23517))
+                    ]
+                    try:
+                        key, public = verify(folder, cert, port)
+                        standby = folder / "standby"
+                        standby.mkdir()
+                        with sqlite3.connect(folder / "db_v2.sqlite3") as source:
+                            with sqlite3.connect(standby / "db_v2.sqlite3") as replica:
+                                source.backup(replica)
+                        services[0].terminate()
+                        services[0].wait(timeout=10)
+                        services.append(stack.enter_context(subprocess.Popen(
+                            [hbbs, "-p", "23516"], env=env, cwd=standby, stdout=log, stderr=log
+                        )))
+                        wait_rendezvous()
+                        with tls_connection(cert, port, "/ws/register") as migrated:
+                            migrated.send_binary(signed_registration(folder, key, public, migrated.recv()))
+                            assert migrated.recv() == field(16, b""), "ID could not reconnect after promotion"
+                            migrated.send_binary(b"")
+                            assert migrated.recv() == b""
+                        print("Existing ID reconnected over TLS after promotion of a copied peer database.")
+                    except Exception:
+                        log.seek(0)
+                        print(log.read())
+                        raise
+                    finally:
+                        for service in services:
+                            if service.poll() is None:
+                                service.terminate()
+                        proxy.shutdown()
+
+
+def tls_connection(cert, port, path):
+    trust = {"ca_certs": str(cert), "check_hostname": True, "cert_reqs": ssl.CERT_REQUIRED}
+    return closing(websocket.create_connection(f"wss://localhost:{port}{path}", sslopt=trust, timeout=5))
+
+
+def wait_rendezvous():
+    for retry in range(40):
+        try:
+            with socket.create_connection(("127.0.0.1", 23518), timeout=1):
+                break
+        except OSError:
+            if retry == 39:
+                raise
+            time.sleep(0.2)
+
+
+def verify(folder, cert, port):
+    wait_rendezvous()
+
+    def connect(path):
+        return tls_connection(cert, port, path)
+
+    try:
+        websocket.create_connection(f"wss://localhost:{port}/ws/register", timeout=5)
+        raise AssertionError("Untrusted certificate was accepted")
+    except ssl.SSLCertVerificationError:
+        pass
+
+    try:
+        websocket.create_connection("ws://localhost:23518/ws/register", timeout=5)
+        raise AssertionError("The registration handler accepted a request without the TLS proxy header")
+    except websocket.WebSocketBadStatusException as failure:
+        assert failure.status_code == 404
+
+    licence_key = (folder / "id_ed25519.pub").read_bytes().strip()
+    key, public = keypair(folder, "device")
+    with connect("/ws/register") as device:
+        nonce = device.recv()
+        assert isinstance(nonce, bytes) and len(nonce) == 32
+        frame = signed_registration(folder, key, public, nonce)
+        device.send_binary(frame)
+        assert device.recv() == field(16, b""), "Fresh key rejected"
+        device.send_binary(b"")
+        assert device.recv() == b"", "Heartbeat through TLS failed"
+        with ExitStack() as controllers:
+            requests = []
+            for marker in (b"first-controller", b"second-controller"):
+                controller = controllers.enter_context(connect("/ws/id"))
+                controller.send_binary(field(8, field(1, ID) + field(3, licence_key)))
+                request = device.recv()
+                assert request[:1] == b"J", "Incoming session request did not reach the TLS device"
+                assert request[1] < 128 and request[2] == 10 and request[3] < 128
+                address = request[4:4 + request[3]]
+                requests.append((controller, address, marker))
+            for controller, address, marker in requests:
+                with connect("/ws/id") as reply:
+                    reply.send_binary(field(19, field(1, address) + field(2, marker)))
+                assert marker in controller.recv(), "Reply went to the wrong controller behind NAT"
+
+        with connect("/ws/register") as replay:
+            assert replay.recv() != nonce
+            replay.send_binary(frame)
+            try:
+                reply = replay.recv()
+            except websocket.WebSocketConnectionClosedException:
+                reply = ""
+            assert not reply, "A signature from a previous connection was accepted"
+
+        with connect("/ws/register") as collision:
+            other, other_public = keypair(folder, "different-device")
+            collision.send_binary(signed_registration(folder, other, other_public, collision.recv()))
+            assert collision.recv() == field(16, b"\x08\x02"), "A different key took over the device"
+
+    with connect("/ws/register") as reconnected:
+        reconnected.send_binary(signed_registration(folder, key, public, reconnected.recv()))
+        assert reconnected.recv() == field(16, b""), "Device could not reconnect with the same ID"
+    with sqlite3.connect((folder / "db_v2.sqlite3").as_uri() + "?mode=ro", uri=True) as database:
+        _, confirmed_key = database.execute("SELECT id,pk FROM peer WHERE id=?", (ID.decode(),)).fetchone()
+        assert confirmed_key == public, "Persistent key binding differs"
+
+    for _ in range(6):
+        relay_request = field(18, field(2, str(uuid4()).encode()))
+        with connect("/ws/relay") as client, connect("/ws/relay") as peer:
+            client.send_binary(relay_request)
+            peer.send_binary(relay_request)
+            client.send_binary(b"lab forward")
+            assert peer.recv() == b"lab forward"
+            peer.send_binary(b"lab reply")
+            assert client.recv() == b"lab reply"
+
+    print(f"TLS port {port}: trusted certificate, fresh ID, heartbeat, incoming request, replay rejection, reconnect and bidirectional relay verified.")
+
+    _, legacy_key = keypair(folder, "old-client")
+    registration = field(15, field(1, b"1456789765") + field(2, UUID) + field(3, legacy_key))
+    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as legacy:
+        legacy.settimeout(4)
+        legacy.sendto(registration, ("127.0.0.1", 23516))
+        assert legacy.recvfrom(128)[0] == field(16, b""), "Existing UDP registration failed"
+    print("Existing clients can still register over UDP.")
+    return key, public
+
+
+if __name__ == "__main__":
+    main()
